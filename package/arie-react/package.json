{
  "name": "arie-js",
  "version": "1.0.0",
  "description": "",
  "author": "Chandler Chappell <chan@atlrdsgn.com>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chvndler/arie.js.git"
  },
  "main": "./dist/arie.mjs",
  "module": "./dist/arie.mjs",
  "exports": {
    ".": {
      "types": "./dist/arie-js.d.ts",
      "require": "./dist/arie.mjs",
      "import": "./dist/arie.mjs",
      "default": "./dist/arie.mjs"
    }
  },
  "typings": "./dist/arie-js.d.ts",
  "types": "./dist/arie-js.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && dts-bundle-generator --config ./dts-bundle-generator.config.ts",
    "test": "vitest",
    "clean": "turbo run clean && rm -rf node_modules",
    "pretty": "prettier --write \"**/*.{ts,tsx,md}\"",
    "release": "yarn build && npm publish --access public"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dts-bundle-generator": "^8.1.2",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "tslib": "^2.8.1",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
